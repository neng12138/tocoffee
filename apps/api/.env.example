# 复制为 apps/api/.env；.env 已被 .gitignore 忽略
NODE_ENV=development
API_PORT=3000

DATABASE_URL=postgresql://tocoffee:tocoffee@localhost:5433/tocoffee?schema=public

JWT_CUSTOMER_SECRET=dev-customer-secret-change-me
JWT_STAFF_SECRET=dev-staff-secret-change-me
JWT_CUSTOMER_EXPIRES_IN=7d
JWT_STAFF_EXPIRES_IN=24h

AUTH_DEV_MODE=true
PAYMENT_MODE=mock
PUBLIC_BASE_URL=http://localhost:3000
